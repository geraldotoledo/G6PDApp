{
  "name": "g6pd-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run rules:sync",
    "rules:sync": "node --import tsx scripts/sync-rules.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "audit": "node --import tsx scripts/audit-rules.ts"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "qrcode": "^1.5.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
